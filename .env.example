# HeliosGen is a local-only app. Values here are optional fallbacks for
# `pnpm dev` / Docker — URLs are normally saved in Settings → Local providers
# and stored in the local SQLite DB. Environment variables override stored URLs.

# ComfyUI HTTP API (image + video generation)
COMFYUI_URL=http://host.docker.internal:8188

# Ollama HTTP API (chat assistant)
OLLAMA_URL=http://host.docker.internal:11434

# Optional writable paths (defaults: ./data and ./public/generated)
# HELIOS_DATA_DIR=
# HELIOS_MEDIA_DIR=

# Verbose client logging
NEXT_PUBLIC_DEBUG=
